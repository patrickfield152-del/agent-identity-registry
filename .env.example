# skjold environment template. Copy to .env and fill in locally; never commit .env.
# Values below are non-secret stand-ins for the dev deployment.

# Registry contract account: registry.skjold.testnet (dev) / registry.skjold.near (mainnet)
SKJOLD_REGISTRY_ID=registry.skjold.testnet

# Operator full-access key. Signs registry administration, never VCs.
SKJOLD_OPERATOR_KEY=ed25519:REPLACE_WITH_OPERATOR_SECRET_KEY

# VC issuer key. The issuer account holds exactly ONE FullAccess key: this one.
SKJOLD_VC_ISSUER_KEY=ed25519:REPLACE_WITH_ISSUER_SECRET_KEY

# NEAR network and RPC endpoint used by the services and the SDK.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# REST API key for the single-tenant demo server.
SKJOLD_API_KEY=REPLACE_WITH_API_KEY

# The demo has one tenant; the only accepted value is "default".
DEFAULT_TENANT=default
